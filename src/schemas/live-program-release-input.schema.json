{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fifthbell.invalid/schemas/live-program-release-input-v1.schema.json",
  "title": "Fifthbell live-program release input",
  "type": "object",
  "additionalProperties": false,
  "required": ["programId", "apiBaseUrl"],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "apiBaseUrl": {
      "type": "string",
      "format": "uri",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
        },
        {
          "type": "string",
          "pattern": "^http://localhost(?::[0-9]+)?(?:/[^?#]*)?$"
        },
        {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1(?::[0-9]+)?(?:/[^?#]*)?$"
        }
      ]
    }
  }
}
