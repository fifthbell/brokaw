<header
  class='site-header sticky top-0 z-[60] border-b transition-colors'
  style='view-transition-name: site-header;'
>
  <div class='weather-utility-bar' data-weather-utility-bar data-language='{{language}}'>
    <div class='container mx-auto flex h-10 items-center justify-between gap-4 px-4'>
      <time class='weather-utility-date' data-weather-date aria-label='Current date'></time>
      <div class='weather-utility-current' data-weather-current aria-live='polite' aria-atomic='true' hidden>
        <span class='weather-utility-icon' data-weather-icon aria-hidden='true'></span>
        <span class='weather-utility-city' data-weather-city></span>
        <span class='weather-utility-temperature' data-weather-temperature></span>
        <span class='weather-utility-country' data-weather-country></span>
      </div>
    </div>
  </div>
  <div class='container mx-auto px-4'>
    <nav class='relative flex h-[72px] items-center justify-between'>
      <div class='flex items-center'>
        <div class='relative'>
          <button
            id='menu-button'
            class='site-header-action flex h-10 w-10 items-center justify-center hover:bg-black/[0.04] dark:hover:bg-white/[0.06] text-[var(--brokaw-ink)]'
            aria-label='Menu'
            aria-expanded='false'
            type='button'
          >
            <svg class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75'>
              <line x1='4' y1='8' x2='20' y2='8'></line>
              <line x1='4' y1='16' x2='16' y2='16'></line>
            </svg>
          </button>

          <div
            id='dropdown-menu'
            class='fixed top-[112px] left-0 right-0 bottom-0 bg-[var(--brokaw-paper)]/98 backdrop-blur-xl shadow-[var(--brokaw-shadow-raised)] z-50 pointer-events-none border-t border-[var(--brokaw-rule)] overflow-hidden transition-colors'
            style='height: calc(100dvh - 112px); opacity: 0; transform: translateX(-100%); transition: transform 360ms var(--brokaw-ease), opacity 180ms var(--brokaw-ease);'
          >
            <div class='container mx-auto px-4 py-4 md:py-8 h-full overflow-y-auto overscroll-contain'>
              <div class='grid grid-cols-1 lg:grid-cols-5 gap-6 lg:gap-8'>
                <div class='lg:col-span-1'>
                  <h3
                    class='text-xs font-bold text-slate-400 dark:text-slate-600 uppercase tracking-wider mb-4 border-b border-slate-200 dark:border-slate-800 pb-2'
                  >SECTIONS</h3>
                  <div id='sections-links' class='space-y-3'>
                    <a
                      href='{{logoLink}}'
                      class='block text-lg font-bold text-black dark:text-white hover:text-[#8f0d00] dark:hover:text-[#ff2e1a] transition-colors'
                    >TOP STORIES</a>
                    <div id='category-links-container' class='space-y-3'>
                      <p class='text-sm text-slate-400 dark:text-slate-500'>Loading sections...</p>
                    </div>
                  </div>

                  <div class='mt-8 pt-6 border-t border-slate-200 dark:border-slate-800'>
                    <h3 class='text-xs font-bold text-slate-400 dark:text-slate-600 uppercase tracking-wider mb-4'>FOLLOW US</h3>
                    <div class='flex items-center gap-3'>
                      <a
                        href='https://bsky.app/profile/fifthbell.com'
                        target='_blank'
                        rel='noopener noreferrer'
                        class='text-slate-600 dark:text-slate-400 hover:text-[#0085ff] dark:hover:text-[#0085ff] transition-colors'
                        aria-label='Follow us on Bluesky'
                      >
                        <svg class='w-5 h-5' viewBox='0 0 600 530' fill='currentColor' xmlns='http://www.w3.org/2000/svg'>
                          <path
                            d='M135.72 44.03c66.496 49.921 138.02 151.14 164.28 205.46 26.262-54.316 97.782-155.54 164.28-205.46 47.98-36.021 125.72-63.892 125.72 24.795 0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.3797-3.6904-10.832-3.7077-7.8964-.0174-2.9357-1.1937.51669-3.7077 7.8964-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.4491-163.25-81.433-5.9562-21.282-16.111-152.36-16.111-170.07 0-88.687 77.742-60.816 125.72-24.795z'
                          ></path>
                        </svg>
                      </a>
                      <a
                        href='https://x.com/thisisfifthbell'
                        target='_blank'
                        rel='noopener noreferrer'
                        class='text-slate-600 dark:text-slate-400 hover:text-[#000000] dark:hover:text-[#ffffff] transition-colors'
                        aria-label='Follow us on X (Twitter)'
                      >
                        <svg class='w-5 h-5' viewBox='0 0 24 24' fill='currentColor' xmlns='http://www.w3.org/2000/svg'>
                          <path
                            d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'
                          ></path>
                        </svg>
                      </a>
                      <a
                        href='https://instagram.com/thisisfifthbell'
                        target='_blank'
                        rel='noopener noreferrer'
                        class='text-slate-600 dark:text-slate-400 hover:text-[#E4405F] dark:hover:text-[#E4405F] transition-colors'
                        aria-label='Follow us on Instagram'
                      >
                        <svg class='w-5 h-5' viewBox='0 0 24 24' fill='currentColor' xmlns='http://www.w3.org/2000/svg'>
                          <path
                            d='M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z'
                          ></path>
                        </svg>
                      </a>
                      <a
                        href='https://www.youtube.com/@thisisfifthbell'
                        target='_blank'
                        rel='noopener noreferrer'
                        class='text-slate-600 dark:text-slate-400 hover:text-[#FF0000] dark:hover:text-[#FF0000] transition-colors'
                        aria-label='Subscribe on YouTube'
                      >
                        <svg class='w-5 h-5' viewBox='0 0 24 24' fill='currentColor' xmlns='http://www.w3.org/2000/svg'>
                          <path
                            d='M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z'
                          ></path>
                        </svg>
                      </a>
                    </div>
                  </div>

                  {{#unless mourningMode}}
                  <div class='mt-8 pt-6 border-t border-slate-200 dark:border-slate-800'>
                    <h3 class='text-xs font-bold text-slate-400 dark:text-slate-600 uppercase tracking-wider mb-4'>THEME</h3>
                    <div class='flex items-center gap-2'>
                      <button
                        id='theme-light'
                        class='theme-btn flex items-center justify-center p-2 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-700 dark:text-slate-300'
                        aria-label='Light mode'
                        data-theme='light'
                        type='button'
                      >
                        <svg
                          class='w-5 h-5'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke='currentColor'
                          stroke-width='2'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                        >
                          <circle cx='12' cy='12' r='4'></circle>
                          <path d='M12 2v2'></path>
                          <path d='M12 20v2'></path>
                          <path d='m4.93 4.93 1.41 1.41'></path>
                          <path d='m17.66 17.66 1.41 1.41'></path>
                          <path d='M2 12h2'></path>
                          <path d='M20 12h2'></path>
                          <path d='m6.34 17.66-1.41 1.41'></path>
                          <path d='m19.07 4.93-1.41 1.41'></path>
                        </svg>
                      </button>
                      <button
                        id='theme-dark'
                        class='theme-btn flex items-center justify-center p-2 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-700 dark:text-slate-300'
                        aria-label='Dark mode'
                        data-theme='dark'
                        type='button'
                      >
                        <svg
                          class='w-5 h-5'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke='currentColor'
                          stroke-width='2'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                        >
                          <path d='M12 3a6 6 0 1 0 9 9 9 9 0 1 1-9-9z'></path>
                        </svg>
                      </button>
                      <button
                        id='theme-system'
                        class='theme-btn flex items-center justify-center p-2 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-700 dark:text-slate-300'
                        aria-label='System theme'
                        data-theme='system'
                        type='button'
                      >
                        <svg
                          class='w-5 h-5'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke='currentColor'
                          stroke-width='2'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                        >
                          <rect x='2' y='3' width='20' height='14' rx='2' ry='2'></rect>
                          <line x1='8' y1='21' x2='16' y2='21'></line>
                          <line x1='12' y1='17' x2='12' y2='21'></line>
                        </svg>
                      </button>
                    </div>
                  </div>
                  {{/unless}}

                  <div class='mt-8 pt-6 border-t border-slate-200 dark:border-slate-800'>
                    <h3 class='text-xs font-bold text-slate-400 dark:text-slate-600 uppercase tracking-wider mb-4'>LANGUAGE</h3>
                    <div class='flex items-center gap-2'>
                      <button
                        class='lang-btn flex items-center justify-center px-3 py-2 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-700 dark:text-slate-300 font-medium text-sm'
                        aria-label='English'
                        data-lang='en'
                        type='button'
                      >
                        EN
                      </button>
                      <button
                        class='lang-btn flex items-center justify-center px-3 py-2 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-700 dark:text-slate-300 font-medium text-sm'
                        aria-label='Español'
                        data-lang='es'
                        type='button'
                      >
                        ES
                      </button>
                      <button
                        class='lang-btn flex items-center justify-center px-3 py-2 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-700 dark:text-slate-300 font-medium text-sm'
                        aria-label='Italiano'
                        data-lang='it'
                        type='button'
                      >
                        IT
                      </button>
                    </div>
                  </div>
                </div>

                <div id='mini-featured' class='lg:col-span-4 hidden lg:block'>
                  <div class='flex flex-col items-center justify-center py-20'>
                    <div class='animate-spin rounded-full h-12 w-12 border-b-2 border-slate-300 dark:border-slate-600'></div>
                    <p class='text-slate-400 dark:text-slate-500 mt-4'>Loading stories...</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class='absolute left-1/2 -translate-x-1/2'>
        <a href='{{logoLink}}' class='site-header-action flex items-center gap-2.5 px-2 py-1 text-[var(--brokaw-ink)]' aria-label='fifthbell - Home'>
          <span class='flex h-9 w-9 items-center justify-center {{#if mourningMode}}bg-black{{else}}bg-[var(--brokaw-signal)]{{/if}} text-white'>
          <svg class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M10.268 21a2 2 0 0 0 3.464 0'></path>
            <path d='M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326'></path>
            <path d='M4 2C2.8 3.7 2 5.7 2 8'></path>
            <path d='M22 8a10 10 0 0 0-2-6'></path>
          </svg></span>
          <span class='hidden font-sans text-[17px] font-medium tracking-[-0.025em] sm:inline'>fifth<span class='font-bold'>bell</span></span>
        </a>
      </div>

      <div class='flex items-center gap-2'>
        <a
          href='{{#if (eq language "en")}}/search{{else}}/{{language}}/search{{/if}}'
          class='site-header-action flex h-10 w-10 items-center justify-center hover:bg-black/[0.04] dark:hover:bg-white/[0.06] text-[var(--brokaw-ink)]'
          aria-label='Search'
        >
          <svg class='w-4 h-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
            <circle cx='11' cy='11' r='8'></circle>
            <line x1='21' y1='21' x2='16.65' y2='16.65'></line>
          </svg>
        </a>
        <form
          class='hidden items-center'
          role='search'
          action='{{#if (eq language "en")}}/search{{else}}/{{language}}/search{{/if}}'
          method='get'
        >
          <label for='header-search-input' class='sr-only'>Search</label>
          <input
            id='header-search-input'
            name='q'
            type='search'
            autocomplete='off'
            spellcheck='false'
            placeholder='Search'
            class='w-44 lg:w-56 px-3 py-2 border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-[#b21100]/40'
          />
        </form>
        <a
          href='https://www.youtube.com/watch?v=-eYi7dd8VRY'
          target='_blank'
          rel='noopener noreferrer'
          class='site-header-action hidden items-center gap-2 border border-[var(--brokaw-rule)] px-4 py-2 font-sans text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--brokaw-ink)] hover:border-[var(--brokaw-signal)] hover:text-[var(--brokaw-signal)] md:flex'
        >
          <svg class='w-5 h-5' viewBox='0 0 24 24' fill='currentColor'>
            <path d='M8 5v14l11-7z'></path>
          </svg>
          <span>Watch Live</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  (function () { const WEATHER_URL = 'https://cdn.fifthbell.com/content/weather-current.json'; const REFRESH_MS = 60 * 60 * 1000; const PHASE_MS = 5 * 1000;
  const barElement = document.querySelector('[data-weather-utility-bar]'); const dateElement = document.querySelector('[data-weather-date]'); const weatherElement = document.querySelector('[data-weather-current]'); const iconElement
  = document.querySelector('[data-weather-icon]'); const cityElement = document.querySelector('[data-weather-city]'); const temperatureElement =
  document.querySelector('[data-weather-temperature]'); const countryElement = document.querySelector('[data-weather-country]'); let cities = []; let phase =
  0; let phaseTimer; function language() { const configured = barElement?.dataset.language; if (configured === 'es') return 'es-CL'; if (configured === 'it')
  return 'it-IT'; const path = window.location.pathname || '/'; if (path === '/es' || path.startsWith('/es/')) return 'es-CL'; if (path === '/it' ||
  path.startsWith('/it/')) return 'it-IT'; return 'en-US'; } function updateDate() { if (!dateElement) return; const now = new Date();
  dateElement.dateTime = now.toISOString(); dateElement.textContent = new Intl.DateTimeFormat(language(), { day: 'numeric', month: 'long', year: 'numeric'
  }).format(now); } function countryKey(city) { return String(city?.country || '').trim().toLocaleLowerCase(); } function arrangeCities(input) { const groups = new
  Map(); const order = []; input.forEach((city) => { const key = countryKey(city); if (!key) return; if (!groups.has(key)) { groups.set(key, []); order.push(key);
  } groups.get(key).push(city); }); const arranged = []; let previous = ''; while (arranged.length < input.length) { const candidates = order.filter((key) =>
  groups.get(key)?.length && key !== previous).sort((a, b) => groups.get(b).length - groups.get(a).length); const key = candidates[0] || order.find((candidate) =>
  groups.get(candidate)?.length); if (!key) break; arranged.push(groups.get(key).shift()); previous = key; } if (arranged.length > 2 && countryKey(arranged[0]) ===
  countryKey(arranged[arranged.length - 1])) { for (let index = 1; index < arranged.length - 1; index += 1) { const candidate = arranged[index]; const last =
  arranged[arranged.length - 1]; const before = arranged[index - 1]; const after = arranged[index + 1]; const beforeLast = arranged[arranged.length - 2]; if
  (countryKey(candidate) !== countryKey(arranged[0]) && countryKey(candidate) !== countryKey(beforeLast) && countryKey(last) !== countryKey(before) &&
  countryKey(last) !== countryKey(after)) { arranged[index] = last; arranged[arranged.length - 1] = candidate; break; } } } return arranged; } function iconSvg(condition)
  { const common = `viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"`; const icons
  = { sunny: `<svg ${common}><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>`, cloudy: `<svg ${common}><path d="M17.5 19H9a7 7 0 1 1 6.7-9h1.8a4.5 4.5 0 1 1 0 9Z"></path></svg>`, rainy: `<svg ${common}><path d="M16 13a4 4 0 1 0-3.8-5.2A5 5 0 1 0 6 15h10a4 4 0 0 0 0-8"></path><path d="m8 19-1 2m5-2-1 2m5-2-1 2"></path></svg>`, windy: `<svg ${common}><path d="M3 8h10a2 2 0 1 0-2-2M3 12h15a2 2 0 1 1-2 2M3 16h8"></path></svg>` }; return icons[condition] || icons.cloudy; }
  function renderWeather() { if (!weatherElement || cities.length === 0) return; const city = cities[Math.floor(phase / 2) % cities.length]; const celsius = phase
  % 2 === 0; const fahrenheit = Number(city.temp); const temperature = celsius ? Math.round((fahrenheit - 32) * 5 / 9) : Math.round(fahrenheit); cityElement.textContent
  = city.name || ''; countryElement.textContent = city.country || ''; temperatureElement.textContent = `${temperature}°${celsius ? 'C' : 'F'}`;
  iconElement.innerHTML = iconSvg(city.condition); weatherElement.hidden = false; weatherElement.dataset.weatherCity = city.name || '';
  weatherElement.dataset.weatherCountry = city.country || ''; weatherElement.dataset.weatherUnit = celsius ? 'celsius' : 'fahrenheit';
  weatherElement.classList.remove('weather-utility-swap'); void weatherElement.offsetWidth; weatherElement.classList.add('weather-utility-swap'); } function
  setWeather(payload) { if (!Array.isArray(payload?.cities)) return; const valid = payload.cities.filter((city) => city && city.name && city.country &&
  Number.isFinite(Number(city.temp))); cities = arrangeCities(valid); if (barElement) barElement.dataset.weatherSequence = cities.map((city) =>
  city.country).join('|'); phase = 0; renderWeather(); window.clearInterval(phaseTimer); if (cities.length) phaseTimer =
  window.setInterval(() => { phase += 1; renderWeather(); }, PHASE_MS); } async function refreshWeather() { try { const response = await
  fetch(`${WEATHER_URL}?v=${Date.now()}`, { cache: 'no-store' }); if (!response.ok) throw new Error(`Weather request failed with HTTP ${response.status}`); const
  payload = await response.json(); window.fifthbellWeather = payload; window.dispatchEvent(new CustomEvent('fifthbell:weather', { detail:
  payload })); } catch (error) { console.error('Failed to refresh weather data:', error); } } window.addEventListener('fifthbell:weather', (event) =>
  setWeather(event.detail)); updateDate(); window.setInterval(updateDate, 60 * 1000); void refreshWeather(); window.setInterval(refreshWeather, REFRESH_MS); })();
</script>

<script>
  (function () { const menuButton = document.getElementById('menu-button'); const dropdownMenu = document.getElementById('dropdown-menu'); const sectionsLinks =
  document.getElementById('sections-links'); const categoryLinksContainer = document.getElementById('category-links-container'); const miniFeatured =
  document.getElementById('mini-featured'); if (!menuButton || !dropdownMenu) return; let isOpen = false; let contentLoaded = false; let currentCategoryKey =
  '__home__'; let activeCategorySlug = ''; let requestVersion = 0; const cache = new Map(); function getCurrentLang() { const p = window.location.pathname ||
  '/'; if (p.startsWith('/es')) return 'es'; if (p.startsWith('/it')) return 'it'; return 'en'; } function buildLocalePath(slug) { const lang =
  getCurrentLang(); if (!slug) return lang === 'en' ? '/' : `/${lang}`; const normalized = String(slug).startsWith('/') ? String(slug) : `/${slug}`; if
  (normalized.startsWith('/es/') || normalized.startsWith('/it/')) return normalized; if (lang === 'en') return normalized; return `/${lang}${normalized}`; }
  function normalizePathInput(value) { if (typeof value !== 'string') return ''; const trimmed = value.trim(); if (!trimmed) return ''; try { if
  (/^https?:\/\//i.test(trimmed)) { const parsed = new URL(trimmed); const normalizedAbsolute = `/${(parsed.pathname || '').replace(/^\/+/,
  '')}`.replace(/\/{2,}/g, '/'); if (normalizedAbsolute !== '/' && normalizedAbsolute.endsWith('/')) { return normalizedAbsolute.slice(0, -1); } return
  normalizedAbsolute || '/'; } } catch { /* Fall back to raw string normalization below */ } const withoutQueryOrHash = trimmed.split('#')[0].split('?')[0]; const
  normalized = `/${withoutQueryOrHash.replace(/^\/+/, '')}`.replace(/\/{2,}/g, '/'); if (normalized !== '/' && normalized.endsWith('/')) { return
