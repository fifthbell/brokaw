<section class='my-8'>
  <h4 class='text-sm uppercase tracking-wider font-bold text-slate-700 dark:text-slate-300 mb-3'>{{title}}</h4>
  <ul class='space-y-2'>
    {{#each links}}
      <li class='border-l-2 border-slate-200 dark:border-slate-700 pl-3'>
        <a href='{{url}}' class='text-slate-900 dark:text-slate-100 hover:text-[#b21100] dark:hover:text-[#ff2e1a] transition-colors font-medium' target='_blank' rel='noopener noreferrer'>
          {{label}}
        </a>
      </li>
    {{/each}}
  </ul>
</section>
