<div class='flex flex-col'>
  <a href='{{url}}' class='mb-4 flex-shrink-0 h-[180px] block'>
    <img src='{{image}}' width='500' height='200' alt='{{alt}}' class='w-full h-full object-cover rounded' />
  </a>
  <div class='flex items-center text-slate-500 dark:text-slate-400 text-sm mb-2'>
    <span class='uppercase font-bold'>{{category}}</span>
    <span class='mx-2'>•</span>
    <span>{{readTime}}</span>
  </div>
  <h2 class='text-xl font-bold font-encode mb-2 text-slate-900 dark:text-slate-100 leading-tight'>
    <a href='{{url}}' class='hover:text-[#b21100] dark:hover:text-[#ff2e1a] transition-colors'>{{title}}</a>
  </h2>
  <p class='text-slate-600 dark:text-slate-400 flex-grow text-base leading-relaxed'>{{excerpt}}</p>
</div>
