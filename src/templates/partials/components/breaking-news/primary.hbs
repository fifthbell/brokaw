<div class='bg-black text-white flex flex-col rounded-lg overflow-hidden flex-1'>
  <div class='flex-grow min-h-[250px] bg-cover bg-center flex flex-col justify-end' style='background-image: linear-gradient(to top, rgba(0,0,0,0.9), rgba(0,0,0,0.6) 50%, transparent 100%), url("{{image}}");'>
    <div class='px-4 pb-3'>
      <span class='bg-[#b21100] text-white px-3 py-2 text-xs tracking-[1px] font-bold uppercase inline-block mb-2'>{{category}}</span>
      <h2 class='text-2xl font-bold font-encode mb-0'>
        <a href='{{slug}}' class='hover:text-slate-300 transition-colors'>{{title}}</a>
      </h2>
    </div>
  </div>
  <div class='px-4 py-3 flex-shrink-0 bg-black'>
    <p class='text-sm leading-relaxed'>{{excerpt}}</p>
  </div>
</div>
