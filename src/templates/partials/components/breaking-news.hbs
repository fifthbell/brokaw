<div class='mx-auto xl:px-4 pb-8 my-4 {{#if displayClass}}{{displayClass}}{{/if}}'>
  <div class='grid grid-cols-1 xl:grid-cols-12 xl:gap-8 mb-4'>
    <section class='xl:col-span-3 flex flex-col h-full gap-6 xl:order-1 order-2 px-4 xl:px-0 mb-8 xl:mb-0'>
      {{#with sidebarFeature}}
        {{> components/breaking-news/primary}}
      {{/with}}

      {{#with sidebarSub}}
        {{> components/breaking-news/secondary}}
      {{/with}}
    </section>

    {{#with main}}
      {{> components/breaking-news/live-updates-column updates=../updates}}
    {{/with}}

    {{> components/breaking-news/candy-bar snacks=snacks}}
  </div>
</div>
