<div class='grid grid-cols-12 gap-6 px-6'>
  <div class='col-span-12 space-y-12 pt-6 lg:col-span-9 lg:pt-8 xl:col-span-6'>
    {{#with homepageSlots.landing.headline1}}
      <section class='flex flex-col'>
        <a href='{{url}}' class='editorial-image relative block flex-shrink-0'>
          <img src='{{featuredImage.url}}' alt='{{featuredImage.alt}}' class='h-[400px] w-full object-cover' fetchpriority='high' />
        </a>

        <div class='mt-4 flex flex-grow flex-col'>
          <div class='editorial-meta mb-4 flex items-center'>
            <span class='editorial-kicker'>{{#with (lookup categories 0)}}{{name}}{{/with}}</span>
            <span class='mx-3 text-black/25 dark:text-white/25'>/</span>
            <span class='article-time' data-timestamp='{{updatedAt}}'>{{formatDate updatedAt}}</span>
          </div>

          <h1 class='mb-4 font-encode text-4xl font-bold leading-11 tracking-[-0.025em] text-[var(--brokaw-ink)]'>
            <a href='{{url}}' class='editorial-link'>{{title}}</a>
          </h1>

          <p class='mb-4 font-secondary text-2xl leading-8 text-[var(--brokaw-ink-muted)]'>{{excerpt}}</p>

          <div class='editorial-rule mt-4 grid flex-grow grid-cols-1 gap-6 border-t pt-6 md:grid-cols-2'>
            {{#each ../homepageSlots.landing.sub1}}
              {{> components/snack
                url=url
                title=title
                excerpt=excerpt
                showExcerpt=false
                image=featuredImage.url
                alt=featuredImage.alt
                readTime=(formatDate updatedAt)
                imageSize='w-24 h-24'
                imageClasses=''
                titleTextSize='text-lg'
                titleFontWeight='font-medium'
                titleClasses='font-encode'
              }}
            {{/each}}
          </div>
        </div>
      </section>
    {{/with}}
  </div>

  <div class='col-span-12 space-y-12 pt-6 md:col-span-7 lg:col-span-3 lg:pt-8'>
    <section class='lg:col-span-1 xl:col-span-4 flex flex-col h-full justify-between'>
      {{#with homepageSlots.landing.card5}}
        <div class='mb-6 flex flex-grow flex-col bg-[var(--brokaw-night)] text-white shadow-[var(--brokaw-shadow-raised)]'>
          <div class='flex-grow min-h-[250px] bg-cover bg-center flex flex-col justify-end' style='background-image: linear-gradient(to top, rgba(0,0,0,1), rgba(0,0,0,0.7) 50%, transparent 100%), url("{{featuredImage.url}}");'>
            <div class='px-4'>
              <span class='mb-3 inline-block text-[11px] font-bold uppercase tracking-[0.14em] text-white/70'>{{#with (lookup categories 0)}}{{name}}{{/with}}</span>
              <h2 class='mb-2 font-encode text-2xl font-bold leading-[1.08]'>
                <a href='{{url}}' class='hover:text-slate-300 transition-colors'>{{title}}</a>
              </h2>
            </div>
          </div>
          <div class='flex-shrink-0 px-4 pb-4 pt-3'>
            <p class='font-secondary text-sm leading-5 text-white/75'>{{excerpt}}</p>
            <span class='mt-2 block text-xs tabular-nums text-white/45'>{{formatDate updatedAt}}</span>
          </div>
        </div>
      {{/with}}

      {{#with homepageSlots.landing.headline6}}
        <div class='flex flex-col'>
          <a href='{{url}}' class='mb-4 flex-shrink-0 h-[180px] block'>
            <img src='{{featuredImage.url}}' width='500' height='200' alt='{{featuredImage.alt}}' class='h-full w-full object-cover' />
          </a>
          <div class='flex items-center text-slate-500 dark:text-slate-400 text-sm mb-2'>
            <span class='uppercase font-bold'>{{#with (lookup categories 0)}}{{name}}{{/with}}</span>
            <span class='mx-2'>•</span>
            <span>{{formatDate updatedAt}}</span>
          </div>
          <h2 class='text-xl font-bold font-encode mb-2 text-slate-900 dark:text-slate-100'>
            <a href='{{url}}' class='hover:text-[#8f0d00] dark:hover:text-[#ff2e1a] transition-colors'>{{title}}</a>
          </h2>
          <p class='text-slate-600 dark:text-slate-400 flex-grow'>{{excerpt}}</p>
        </div>
      {{/with}}
    </section>
  </div>

  <aside class='col-span-12 pt-6 md:col-span-5 lg:col-span-12 xl:col-span-3'>
    <div class='space-y-10'>
      <div class='space-y-6'>
        <div class='editorial-rule flex items-center justify-between border-b pb-3'>
          <h3 class='editorial-kicker'>Top Stories</h3>
        </div>
      </div>

      <div class='space-y-6 lg:grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-1 lg:gap-6 lg:space-y-0'>
        {{#each homepageSlots.landing.topStories}}
          {{> components/snack
            url=url
            title=title
            image=featuredImage.url
            alt=featuredImage.alt
            readTime=(formatDate updatedAt)
            showExcerpt=false
            className='pb-4 border-b border-slate-200 dark:border-slate-800'
            imageSize='w-20 h-20'
            imageClasses='bg-slate-200 grayscale hover:grayscale-0 transition-all'
            titleTextSize='text-xl'
            titleFontWeight='font-bold'
            titleClasses='font-encode leading-snug'
          }}
        {{/each}}
      </div>
    </div>
  </aside>
</div>
