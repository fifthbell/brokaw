{{!--
  Atom 1.0 feed of the latest released stories of one language
  (fifthbell/cronkite#157). Text is escaped as XML text: Handlebars turns & < >
  and quotes into character references, which XML reads back as the same
  characters. Nothing is invented: an entry without a summary or an image has no
  such element. The feed's own id is its self URL; an entry's id is the story's
  canonical URL.
--}}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{language}}">
  <title>{{title}}</title>
{{#if subtitle}}
  <subtitle>{{subtitle}}</subtitle>
{{/if}}
  <link rel="alternate" type="text/html" href="{{homeUrl}}"/>
  <link rel="self" type="application/atom+xml" href="{{selfUrl}}"/>
  <id>{{selfUrl}}</id>
  <updated>{{updated}}</updated>
{{#each entries}}
  <entry>
    <title>{{title}}</title>
    <link rel="alternate" type="text/html" href="{{url}}"/>
    <id>{{id}}</id>
    <published>{{published}}</published>
    <updated>{{updated}}</updated>
{{#if summary}}
    <summary>{{summary}}</summary>
{{/if}}
{{#if imageUrl}}
    <link rel="enclosure" href="{{imageUrl}}"/>
{{/if}}
  </entry>
{{/each}}
</feed>
